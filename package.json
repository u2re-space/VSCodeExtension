{
    "name": "vext",
    "displayName": "U2RE utils pack and toolkit",
    "description": "U2RE utils pack and toolkit",
    "publisher": "u2re-dev",
    "readme": "./README.md",
    "version": "0.0.8",
    "engines": {
        "vscode": "^1.105.1"
    },
    "icon": "./assets/service.png",
    "categories": [
        "Education",
        "Other",
        "AI",
        "Chat"
    ],
    "type": "module",
    "files": [
        "dist/extension.mjs",
        "icons/**",
        "assets/**",
        "modules/**",
        "LICENSE",
        "README.md",
        "CHANGELOG.md",
        "package.json"
    ],
    "activationEvents": [
        "onView:vext.managerView",
        "onView:vext.managerPanelView",
        "onView:vext.gptView",
        "onView:vext.gptPanelView",
        "onCommand:vext.pasteAsSymlink",
        "onCommand:vext.proxyUndo",
        "onCommand:vext.proxyRedo",
        "onCommand:vext.htd.paste",
        "onCommand:vext.htd.convert",
        "onCommand:vext.htd.copy",
        "onCommand:vext.dth.paste",
        "onCommand:vext.dth.convert",
        "onCommand:vext.dth.copy",
        "onCommand:vext.ltm.paste",
        "onCommand:vext.ltm.convert",
        "onCommand:vext.ltm.copy",
        "onCommand:vext.mtl.paste",
        "onCommand:vext.mtl.convert",
        "onCommand:vext.mtl.copy"
    ],
    "extensionKind": [
        "ui"
    ],
    "main": "./dist/extension.mjs",
    "contributes": {
        "menus": {
            "explorer/context": [
                {
                    "command": "vext.pasteAsSymlink",
                    "group": "5\\_cutcopypaste"
                }
            ],
            "editor/context": [
                {
                    "command": "vext.htd.paste",
                    "group": "Markdown@1"
                },
                {
                    "command": "vext.htd.convert",
                    "group": "Markdown@1"
                },
                {
                    "command": "vext.htd.copy",
                    "group": "Markdown@1"
                },
                {
                    "command": "vext.dth.paste",
                    "group": "HTML@2"
                },
                {
                    "command": "vext.dth.convert",
                    "group": "HTML@2"
                },
                {
                    "command": "vext.dth.copy",
                    "group": "HTML@2"
                },
                {
                    "command": "vext.ltm.paste",
                    "group": "MathML@3"
                },
                {
                    "command": "vext.ltm.convert",
                    "group": "MathML@3"
                },
                {
                    "command": "vext.ltm.copy",
                    "group": "MathML@3"
                },
                {
                    "command": "vext.mtl.paste",
                    "group": "LaTeX@4"
                },
                {
                    "command": "vext.mtl.convert",
                    "group": "LaTeX@4"
                },
                {
                    "command": "vext.mtl.copy",
                    "group": "LaTeX@4"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "managerView",
                    "title": "Manager View",
                    "icon": "assets/folder.svg"
                },
                {
                    "id": "gptView",
                    "title": "GPTunnel View",
                    "icon": "assets/openai.svg"
                }
            ],
            "panel": [
                {
                    "id": "managerPanel",
                    "title": "Manager",
                    "icon": "assets/folder.svg"
                },
                {
                    "id": "gptPanel",
                    "title": "GPTunnel",
                    "icon": "assets/openai.svg"
                }
            ]
        },
        "views": {
            "managerView": [
                {
                    "icon": "assets/folder.svg",
                    "type": "webview",
                    "id": "vext.managerView",
                    "name": "Manager View",
                    "contextualTitle": "Manager View"
                }
            ],
            "managerPanel": [
                {
                    "icon": "assets/folder.svg",
                    "type": "webview",
                    "id": "vext.managerPanelView",
                    "name": "Manager (Panel)",
                    "contextualTitle": "Manager"
                }
            ],
            "gptView": [
                {
                    "icon": "assets/openai.svg",
                    "type": "webview",
                    "id": "vext.gptView",
                    "name": "GPTunnel View",
                    "contextualTitle": "GPTunnel View"
                }
            ],
            "gptPanel": [
                {
                    "icon": "assets/openai.svg",
                    "type": "webview",
                    "id": "vext.gptPanelView",
                    "name": "GPTunnel (Panel)",
                    "contextualTitle": "GPTunnel"
                }
            ]
        },
        "commands": [
            {
                "command": "vext.openManagerPanel",
                "title": "Open Manager (Panel)"
            },
            {
                "command": "vext.pasteAsSymlink",
                "title": "Paste as Symlink"
            },
            {
                "command": "vext.proxyUndo",
                "title": "Undo (contexted)"
            },
            {
                "command": "vext.proxyRedo",
                "title": "Redo (contexted)"
            },
            {
                "command": "vext.htd.paste",
                "title": "Paste as Markdown"
            },
            {
                "command": "vext.htd.convert",
                "title": "Convert to Markdown"
            },
            {
                "command": "vext.htd.copy",
                "title": "Copy as Markdown"
            },
            {
                "command": "vext.dth.paste",
                "title": "Paste as HTML"
            },
            {
                "command": "vext.dth.convert",
                "title": "Convert to HTML"
            },
            {
                "command": "vext.dth.copy",
                "title": "Copy as HTML"
            },
            {
                "command": "vext.ltm.paste",
                "title": "Paste as MathML"
            },
            {
                "command": "vext.ltm.convert",
                "title": "Convert to MathML"
            },
            {
                "command": "vext.ltm.copy",
                "title": "Copy as MathML"
            },
            {
                "command": "vext.mtl.paste",
                "title": "Paste as LaTeX"
            },
            {
                "command": "vext.mtl.convert",
                "title": "Convert to LaTeX"
            },
            {
                "command": "vext.mtl.copy",
                "title": "Copy as LaTeX"
            }
        ]
    },
    "scripts": {
        "vscode:build": "vsce package --allow-missing-repository --out ./dist",
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "build": "npm run compile && npm run vscode:build",
        "clean:cursor-cache": "node scripts/clean-extension-cache.mjs --id u2re-dev.vext --dry-run",
        "clean:cursor-cache:apply": "node scripts/clean-extension-cache.mjs --id u2re-dev.vext --apply",
        "clean:cursor-cache:purge": "node scripts/clean-extension-cache.mjs --id u2re-dev.vext --purge --dry-run",
        "clean:cursor-cache:purge:apply": "node scripts/clean-extension-cache.mjs --id u2re-dev.vext --purge --apply",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src --fix",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.17.57",
        "@types/vscode": "^1.105.1",
        "@typescript-eslint/eslint-plugin": "^8.10.0",
        "@typescript-eslint/parser": "^8.7.0",
        "@vscode/markdown-it-katex": "^1.1.2",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.25.5",
        "eslint": "^9.25.1",
        "marked": "^15.0.12",
        "marked-katex-extension": "^5.1.5",
        "mathml-to-latex": "^1.5.0",
        "npm-run-all": "^4.1.5",
        "temml": "^0.11.7",
        "tsx": "^4.19.4",
        "turndown": "^7.2.0",
        "typescript": "^5.8.3"
    }
}
